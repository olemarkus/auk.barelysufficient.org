{
  "name": "org.barelysufficient.auk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "ts-node": {
    "files": true
  },
  "main": "app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/check-test-titles.js && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run --config vitest.config.ts --coverage.enabled",
    "test:vitest": "vitest run --config vitest.config.ts",
    "start": "homey app run --remote",
    "validate": "npm run lint && npm test && homey app validate"
  },
  "dependencies": {
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^1.8.3",
    "@types/node": "^22.20.5",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
